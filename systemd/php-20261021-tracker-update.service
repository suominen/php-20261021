[Unit]
Description=Update PHP2Shell tracker via Claude Code

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/claude/headless-token.env
ExecStart=%h/src/php-20261021/scripts/auto-update
StandardOutput=journal
StandardError=journal

# Confine the run to what it must write.  The agent is allowed to run
# sort and git log/show/diff, whose -o and --output write wherever
# this user can write -- including the wrapper in the primary checkout
# that ExecStart runs -- so the
# in-wrapper guards are only enforceable with a kernel-level boundary
# under them.  ProtectSystem=strict makes everything read-only, and
# each ReadWritePaths below opens the narrowest subtree that still
# lets the run work: the agent's worktree, and the .git directories
# git fetch and git commit have to update.  Nothing needs to write a
# hook or a git config, and both are executable code, so those are
# handed back as ReadOnlyPaths -- a nested read-only path inside a
# read-write one wins.  A `-` prefix means "skip if absent" so a
# missing optional clone does not fail the whole unit.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# Hide the credential files no run needs.  The agent's requests reach
# only the origins in scripts/fetch-origins, but those still see
# whatever a URL holds, and a few allowlisted readers (xq among them)
# open any path they are given.  This is a denylist, so it narrows
# that rather than closing it, and the headless token itself stays in
# the environment claude runs with.  Its env file goes: systemd reads
# EnvironmentFile before it sets up the namespace, and claude
# authenticates from the environment, not from .credentials.json.
# Not ~/.cfg: ~/.claude/settings.json links into it, and hiding it
# silently drops the user-level settings and hooks.
InaccessiblePaths=-%h/.ssh
InaccessiblePaths=-%h/.aws
InaccessiblePaths=-%h/.gnupg
InaccessiblePaths=-%h/.netrc
InaccessiblePaths=-%h/.git-credentials
InaccessiblePaths=-%h/.cvspass
InaccessiblePaths=-%h/.config/gh
InaccessiblePaths=-%h/.config/claude
InaccessiblePaths=-%h/.claude/.credentials.json
# Claude Code writes a per-session file here on every Bash call,
# so a fully read-only home silently breaks its Bash tool -- the
# run then reports success having verified nothing.  Grant this
# one directory rather than all of ~/.claude, which holds the
# user-level permission settings and plugins.
ReadWritePaths=%h/.claude/session-env
# Session transcripts land here (the wrapper runs claude without
# --no-session-persistence); the write fails silently under a
# read-only home, so the grant is what makes transcripts actually
# appear.  Transcript data only -- settings and plugins stay
# read-only above.
ReadWritePaths=%h/.claude/projects
ReadWritePaths=%h/src/auto-update/php-20261021
ReadWritePaths=%h/src/php-20261021/.git
ReadOnlyPaths=%h/src/php-20261021/.git/hooks
ReadOnlyPaths=%h/src/php-20261021/.git/config
ReadWritePaths=-%h/src/nixos/nixpkgs/.git
ReadOnlyPaths=-%h/src/nixos/nixpkgs/.git/hooks
ReadOnlyPaths=-%h/src/nixos/nixpkgs/.git/config
ReadWritePaths=-%h/src/netbsd/pkgsrc/.git
ReadOnlyPaths=-%h/src/netbsd/pkgsrc/.git/hooks
ReadOnlyPaths=-%h/src/netbsd/pkgsrc/.git/config
